<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.rainyinsaigon</groupId>
    <artifactId>fraud-ring-linker-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>fraud-ring-linker-engine</artifactId>
  <packaging>jar</packaging>

  <name>fraud-ring-linker-engine</name>
  <description>Constraint-aware, rarity-weighted linking of accounts controlled by the same fraud actor.</description>

  <properties>
    <!-- The engine holds the fraud logic, so its branch floor is higher than the default. -->
    <coverage.branch.minimum>0.80</coverage.branch.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <!-- Also builds target/fraud-ring-linker.jar, with Jackson bundled, so the CLI runs with `java -jar`.
             The plain module jar stays the main artifact for the service to depend on. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- With outputFile set, the shaded jar neither replaces nor is attached to the main artifact. -->
              <outputFile>${project.build.directory}/fraud-ring-linker.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.rainyinsaigon.fraudlinker.cli.LinkerCli</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Mutation testing: `mvn -Pmutation verify -pl engine`.
           PIT plants small bugs (flips a condition, removes a call) and checks that
           some test fails. It is slow, so it runs in its own CI job, and only on the
           packages where a silent bug would change a fraud decision. -->
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>io.github.rainyinsaigon.fraudlinker.scoring.*</param>
                <param>io.github.rainyinsaigon.fraudlinker.clustering.*</param>
              </targetClasses>
              <targetTests>
                <param>io.github.rainyinsaigon.fraudlinker.*</param>
              </targetTests>
              <mutationThreshold>${mutation.minimum}</mutationThreshold>
              <timestampedReports>false</timestampedReports>
              <outputFormats>
                <param>HTML</param>
                <param>XML</param>
              </outputFormats>
            </configuration>
            <executions>
              <execution>
                <phase>verify</phase>
                <goals><goal>mutationCoverage</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
